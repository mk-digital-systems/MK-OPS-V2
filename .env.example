# MK OPS — Şantiye Operasyon Yönetimi
# Gerçek anahtarları .env.local dosyasına yazın (bu dosyaya değil).

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# Google Analytics 4 ve Google Ads (genel kimlikler; gizli anahtar değildir)
NEXT_PUBLIC_GA4_MEASUREMENT_ID=G-40SZSCSHN9
NEXT_PUBLIC_GOOGLE_ADS_ID=AW-18239084469

# Cloudflare Turnstile (CAPTCHA) SITE KEY: herkese açık anahtar, burada/Vercel'de tutulabilir.
# Boş bırakılırsa CAPTCHA kutusu gösterilmez ve giriş akışı eskisi gibi çalışır.
# SECRET KEY ASLA buraya, repoya veya NEXT_PUBLIC_* değişkenine yazılmaz; yalnızca Supabase paneline
# (Authentication -> Attack Protection -> CAPTCHA) girilir.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
